# Imagem da aplicação web (Django + Gunicorn). Os arquivos estáticos são
# coletados na construção e entregues pela própria aplicação (WhiteNoise).
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt requirements-web.txt ./
RUN pip install --no-cache-dir -r requirements-web.txt \
    && useradd --create-home --uid 10001 sentinel
COPY --chown=sentinel:sentinel . .
RUN mkdir -p /app/staticfiles && chown sentinel:sentinel /app/staticfiles
# A aplicação roda sem privilégio de administrador dentro do container.
USER sentinel
# A chave abaixo existe só para este comando de construção; a chave real
# chega pelo ambiente quando o container sobe.
RUN DJANGO_SECRET_KEY=somente-para-a-construcao-da-imagem-nao-usar-em-execucao-0123456789 \
    DJANGO_DEBUG=0 python manage.py collectstatic --noinput
EXPOSE 8000
# O cabeçalho X-Forwarded-Proto só é considerado quando TRUST_PROXY=1.
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD python -c "import urllib.request; r=urllib.request.Request('http://127.0.0.1:8000/health/',headers={'Host':'localhost','X-Forwarded-Proto':'https'}); urllib.request.urlopen(r,timeout=3)"
CMD ["gunicorn", "sentinel.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2", "--threads", "2", "--timeout", "60", "--access-logfile", "-", "--error-logfile", "-", "--access-logformat", "%(t)s %(m)s %(s)s %(L)s"]
