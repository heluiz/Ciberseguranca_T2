# Arquivos gerados pelo Python ao importar modulos
__pycache__/
*.pyc

# Ambiente virtual do Python (python -m venv .venv): cada maquina cria o
# seu a partir do requirements.txt
.venv/

# Base de dados gerada pelo proprio programa (pasta dados/) e a copia de
# seguranca feita ao converter uma base do Trabalho 1.
# Repositorio guarda codigo, nao dado gerado: cada maquina cria a sua base
# ao rodar o programa pela primeira vez. Os exemplos ficam em
# dados_exemplo/.
dados/
*.t1.bak

# Arquivo temporario da gravacao atomica em armazenamento.py
*.tmp

# Medida de cobertura dos testes (coverage.py) e cache do pytest
.coverage
htmlcov/
.pytest_cache/
