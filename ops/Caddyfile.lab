# Laboratório de HTTPS (card S5_11): proxy reverso com TLS na frente da
# aplicação, no seu computador. Usado por compose.tls.yaml.
#
# "tls internal": o Caddy cria uma autoridade certificadora própria e
# emite o certificado de localhost com ela. É um certificado que nenhum
# navegador conhece (por isso o alerta), como um autoassinado.
#
# As portas de dentro são as mesmas de fora (8080 e 8443), e o
# redirecionamento de HTTP para HTTPS é explícito, com a porta.
{
	http_port 8080
	https_port 8443
	# Sem instalar a CA no sistema (o container não tem permissão para isso).
	skip_install_trust
}

# HTTP só redireciona para HTTPS (301, permanente), mantendo o caminho.
http://localhost:8080, http://127.0.0.1:8080 {
	redir https://{host}:8443{uri} permanent
}

https://localhost:8443, https://127.0.0.1:8443 {
	tls internal
	encode zstd gzip
	# O HSTS é enviado pelo Django (DJANGO_HTTPS=1); o proxy só esconde a
	# própria identificação.
	header -Server
	reverse_proxy app:8000 {
		header_up X-Forwarded-Proto https
	}
}
