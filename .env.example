# Modelo para o perfil com domínio e HTTPS (compose.web.yaml).
# Copie para .env e gere valores próprios; nunca envie .env ao GitHub.
# No servidor da disciplina NÃO é preciso copiar este arquivo:
# sh ops/servidor/subir.sh cria o .env sozinho, com segredos aleatórios.
DJANGO_SECRET_KEY=
POSTGRES_OWNER_PASSWORD=
POSTGRES_PASSWORD=
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel_app
DJANGO_DEBUG=0
SENTINEL_DOMAIN=sentinel.seu-dominio.com.br
DJANGO_ALLOWED_HOSTS=sentinel.seu-dominio.com.br,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://sentinel.seu-dominio.com.br

# Opcionais. Sem eles, HTTPS e MFA de administrador ficam ligados sempre
# que DJANGO_DEBUG=0. Em rede interna sem certificado, use 0 nos dois.
# DJANGO_HTTPS=1
# DJANGO_REQUIRE_MFA=1

# Usados só por compose.servidor.yaml (preenchidos por subir.sh).
# SENTINEL_PORT=8080
# SENTINEL_ADMIN_USER=admin
# SENTINEL_ADMIN_PASSWORD=
# SENTINEL_DEMO=1
