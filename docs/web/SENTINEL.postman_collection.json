{
  "info": {
    "name": "SENTINEL · API REST (testes automáticos)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ciclo completo da API: entra com usuário e senha, cria, consulta, altera (PUT e PATCH), testa os casos de erro e apaga o que criou.\n\nAntes de executar, defina as variáveis username e password (conta com grupo Analista ou superior) e, se preciso, base_url. A API usa a sessão do login e o token CSRF, que a coleção obtém sozinha."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "run",
      "value": ""
    },
    {
      "key": "form_token",
      "value": ""
    },
    {
      "key": "asset_a",
      "value": ""
    },
    {
      "key": "asset_b",
      "value": ""
    },
    {
      "key": "vuln",
      "value": ""
    },
    {
      "key": "finding",
      "value": ""
    },
    {
      "key": "dependency",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Toda alteração precisa do token CSRF, que o servidor entrega em cookie.",
          "const unsafe = !['GET', 'HEAD', 'OPTIONS'].includes(pm.request.method);",
          "if (unsafe && !pm.request.headers.has('X-No-CSRF')) {",
          "    const jar = pm.cookies.jar();",
          "    jar.get(pm.variables.replaceIn('{{base_url}}'), 'csrftoken', (error, token) => {",
          "        if (token) pm.request.headers.upsert({ key: 'X-CSRFToken', value: token });",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0 · Sem sessão",
      "item": [
        {
          "name": "API sem login redireciona para a entrada",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/asset/",
            "header": [],
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 302', () => pm.response.to.have.status(302));",
                  "pm.test('aponta para /entrar/', () => pm.expect(pm.response.headers.get('Location')).to.include('/entrar/'));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "Saúde responde sem login",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health/",
            "header": [],
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('status ok', () => pm.expect(json.status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 · Entrar",
      "item": [
        {
          "name": "Abrir a tela de entrada",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/entrar/",
            "header": [],
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const match = pm.response.text().match(/name=\"csrfmiddlewaretoken\" value=\"([^\"]+)\"/);",
                  "pm.test('formulário traz o token CSRF', () => pm.expect(match).to.not.be.null);",
                  "pm.collectionVariables.set('form_token', match[1]);",
                  "// Sufixo novo a cada execução, para não colidir com registros existentes.",
                  "pm.collectionVariables.set('run', Date.now().toString(36).toUpperCase());"
                ]
              }
            }
          ]
        },
        {
          "name": "Enviar usuário e senha",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/entrar/",
            "header": [
              {
                "key": "Referer",
                "value": "{{base_url}}/entrar/"
              }
            ],
            "description": "Defina as variáveis username e password no ambiente do Postman; não grave senha na coleção.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{username}}"
                },
                {
                  "key": "password",
                  "value": "{{password}}"
                },
                {
                  "key": "csrfmiddlewaretoken",
                  "value": "{{form_token}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 302', () => pm.response.to.have.status(302));",
                  "pm.test('sessão criada', () => pm.expect(pm.cookies.has('sessionid')).to.be.true);"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        }
      ]
    },
