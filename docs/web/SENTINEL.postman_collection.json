                  "const json = pm.response.json();",
                  "const mine = json.rows.find(row => row.id === Number(pm.collectionVariables.get('asset_a')));",
                  "pm.test('ativo criado aparece com risco próprio e efetivo', () => { pm.expect(mine).to.be.an('object'); pm.expect(mine.proprio).to.be.a('number'); pm.expect(mine.efetivo).to.be.at.least(mine.proprio); });"
                ]
              }
            }
          ]
        },
